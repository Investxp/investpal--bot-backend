# ── InvestPal Bot Engine — environment ────────────────────────────────
# Copy to .env and fill in. Never commit real values.

# REQUIRED in production. Shared secret for every /api/* route and the /ws
# socket. The frontend (investpal-app) must be built with
# NEXT_PUBLIC_BOT_ENGINE_TOKEN set to the SAME value.
# Generate one:  openssl rand -hex 32
API_AUTH_TOKEN=

# Keep false unless live execution has passed operational review.
ALLOW_LIVE_TRADING=false

# REQUIRED to persist copy-trading follower credentials encrypted.
# AES-256-GCM key for followers.json. Without it, credentials stay in
# memory only (not persisted). Generate:  openssl rand -hex 32
STORE_SECRET=

# Optional durable files. On Render, point these at the persistent disk.
EXECUTION_JOURNAL_PATH=./data/executions.json
TRADING_CONTROL_PATH=./data/trading-control.json

# Optional: comma-separated CORS allowlist of frontend origins.
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:4003,http://localhost:3000,https://investpal-bot.onrender.com,https://investpal.online,https://investpal.io

# Optional: port (default 4000)
PORT=4000

# ── Platform credentials (existing) ────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
SX_PRIVATE_KEY=
SX_WALLET_ADDRESS=
